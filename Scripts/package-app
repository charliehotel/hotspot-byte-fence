#!/usr/bin/env python3
"""
Hotspot Byte Fence (HBF) - Canonical macOS App Packaging & Signing Script
Packages the SwiftPM build artifact into a canonical macOS .app bundle,
applies ad-hoc code signing, and computes candidate SHA-256 digests.
"""

import sys
import os
import json
import shutil
import zipfile
import hashlib
import argparse
import subprocess
import unicodedata
from pathlib import Path

def compute_sha256(file_path: Path) -> str:
    h = hashlib.sha256()
    with open(file_path, "rb") as f:
        while chunk := f.read(65536):
            h.update(chunk)
    return h.hexdigest()

def compute_app_bundle_sha256(app_bundle_path: Path) -> str:
    """
    Computes hbf-app-bundle-v1-sha256 digest for a macOS .app bundle
    per docs/HotspotByteFence_TechnicalDesign.md Section 10.
    """
    app_bundle_path = app_bundle_path.resolve()
    entries = []

    for root, dirs, files in os.walk(app_bundle_path, followlinks=False):
        dirs.sort()
        files.sort()
        root_path = Path(root)

        for name in files:
            file_path = root_path / name
            rel_path = file_path.relative_to(app_bundle_path).as_posix()
            norm_rel_path = unicodedata.normalize("NFC", rel_path)

            st = file_path.lstat()
            mode_octal = oct(st.st_mode & 0o777)[2:].zfill(4)

            if file_path.is_symlink():
                target = os.readlink(file_path)
                entry = {
                    "entryType": "symlink",
                    "mode": mode_octal,
                    "relativePath": norm_rel_path,
                    "size": st.st_size,
                    "target": target
                }
            else:
                h = hashlib.sha256()
                with open(file_path, "rb") as f:
                    while chunk := f.read(65536):
                        h.update(chunk)
                entry = {
                    "entryType": "file",
                    "mode": mode_octal,
                    "relativePath": norm_rel_path,
                    "sha256": h.hexdigest(),
                    "size": st.st_size
                }
            entries.append(entry)

    entries.sort(key=lambda e: e["relativePath"].encode("utf-8"))
    canonical_json = json.dumps(entries, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(canonical_json.encode("utf-8")).hexdigest()

INFO_PLIST_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>HotspotByteFence</string>
    <key>CFBundleIdentifier</key>
    <string>{bundle_identifier}</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>HotspotByteFence</string>
    <key>CFBundleDisplayName</key>
    <string>Hotspot Byte Fence</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>{version}</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>{min_os}</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>NSLocationUsageDescription</key>
    <string>Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 copylawbot. All rights reserved.</string>
</dict>
</plist>
"""

STRINGS_EN = '''/* English */
CFBundleDisplayName = "Hotspot Byte Fence";
NSLocationUsageDescription = "Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.";
NSLocationWhenInUseUsageDescription = "Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.";
NSLocationAlwaysAndWhenInUseUsageDescription = "Hotspot Byte Fence requires Wi-Fi network identity to monitor hotspot data usage.";
'''

STRINGS_KO = '''/* Korean */
CFBundleDisplayName = "Hotspot Byte Fence";
NSLocationUsageDescription = "Hotspot Byte Fence는 핫스팟 데이터 사용량을 모니터링하기 위해 Wi-Fi 네트워크 식별 정보에 접근합니다.";
NSLocationWhenInUseUsageDescription = "Hotspot Byte Fence는 핫스팟 데이터 사용량을 모니터링하기 위해 Wi-Fi 네트워크 식별 정보에 접근합니다.";
NSLocationAlwaysAndWhenInUseUsageDescription = "Hotspot Byte Fence는 핫스팟 데이터 사용량을 모니터링하기 위해 Wi-Fi 네트워크 식별 정보에 접근합니다.";
'''

def package_app(binary_path: Path, output_dir: Path, sign: bool = True, zip_bundle: bool = True):
    output_dir.mkdir(parents=True, exist_ok=True)
    app_dir = output_dir / "HotspotByteFence.app"
    if app_dir.exists():
        shutil.rmtree(app_dir)

    contents_dir = app_dir / "Contents"
    macos_dir = contents_dir / "MacOS"
    resources_dir = contents_dir / "Resources"
    macos_dir.mkdir(parents=True)
    resources_dir.mkdir(parents=True)

    dest_bin = macos_dir / "HotspotByteFence"
    shutil.copy2(binary_path, dest_bin)
    dest_bin.chmod(0o755)

    manifest_res = subprocess.run([str(binary_path), "--manifest"], capture_output=True, text=True, check=True)
    manifest_data = json.loads(manifest_res.stdout)
    version = manifest_data.get("applicationVersion", "0.1.0-dev")
    bundle_id = manifest_data.get("bundleIdentifier", "com.copylawbot.hotspotbytefence")
    min_os = manifest_data.get("minimumOS", "13.0")

    manifest_digest_res = subprocess.run([str(binary_path), "--manifest-digest"], capture_output=True, text=True, check=True)
    manifest_digest = manifest_digest_res.stdout.strip()

    plist_path = contents_dir / "Info.plist"
    with open(plist_path, "w", encoding="utf-8") as f:
        f.write(INFO_PLIST_TEMPLATE.format(
            bundle_identifier=bundle_id,
            version=version,
            min_os=min_os
        ))

    en_lproj = resources_dir / "en.lproj"
    en_lproj.mkdir(parents=True)
    with open(en_lproj / "InfoPlist.strings", "w", encoding="utf-8") as f:
        f.write(STRINGS_EN)

    ko_lproj = resources_dir / "ko.lproj"
    ko_lproj.mkdir(parents=True)
    with open(ko_lproj / "InfoPlist.strings", "w", encoding="utf-8") as f:
        f.write(STRINGS_KO)

    app_icon_dir = Path("assets/AppIcon")
    if app_icon_dir.exists():
        iconset_dir = output_dir / "AppIcon.iconset"
        if iconset_dir.exists():
            shutil.rmtree(iconset_dir)
        iconset_dir.mkdir(parents=True)
        mapping = {
            "AppIcon-16.png": "icon_16x16.png",
            "AppIcon-32.png": "icon_16x16@2x.png",
            "AppIcon-32.png": "icon_32x32.png",
            "AppIcon-64.png": "icon_32x32@2x.png",
            "AppIcon-128.png": "icon_128x128.png",
            "AppIcon-256.png": "icon_128x128@2x.png",
            "AppIcon-256.png": "icon_256x256.png",
            "AppIcon-512.png": "icon_256x256@2x.png",
            "AppIcon-512.png": "icon_512x512.png",
            "AppIcon-1024.png": "icon_512x512@2x.png",
        }
        for src_name, dst_name in mapping.items():
            src_file = app_icon_dir / src_name
            if src_file.exists():
                shutil.copy2(src_file, iconset_dir / dst_name)
        icns_dest = resources_dir / "AppIcon.icns"
        try:
            subprocess.run(["iconutil", "-c", "icns", str(iconset_dir), "-o", str(icns_dest)], check=True)
        except Exception as e:
            print(f"Warning: iconutil failed: {e}", file=sys.stderr)
        shutil.rmtree(iconset_dir)

    menubar_assets = Path("assets/MenuBar")
    if menubar_assets.exists():
        menubar_dest = resources_dir / "MenuBar"
        shutil.copytree(menubar_assets, menubar_dest, dirs_exist_ok=True)
        for f in menubar_assets.glob("*.png"):
            shutil.copy2(f, resources_dir / f.name)

    print(f"Created bundle at: {app_dir}")

    unsigned_app_sha256 = compute_app_bundle_sha256(app_dir)
    unsigned_exec_sha256 = compute_sha256(dest_bin)

    unsigned_zip_path = None
    unsigned_zip_sha256 = None
    if zip_bundle:
        unsigned_zip_path = output_dir / f"HotspotByteFence-{version}-unsigned.zip"
        shutil.make_archive(str(output_dir / f"HotspotByteFence-{version}-unsigned"), 'zip', root_dir=output_dir, base_dir="HotspotByteFence.app")
        unsigned_zip_sha256 = compute_sha256(unsigned_zip_path)
        print(f"Created unsigned ZIP: {unsigned_zip_path} (SHA-256: {unsigned_zip_sha256})")

    signed_app_sha256 = unsigned_app_sha256
    signed_exec_sha256 = unsigned_exec_sha256
    signature_status = "unsigned"

    if sign:
        print("Applying canonical ad-hoc code signing: codesign -s - --force --deep HotspotByteFence.app")
        sign_res = subprocess.run(["codesign", "-s", "-", "--force", "--deep", str(app_dir)], capture_output=True, text=True)
        if sign_res.returncode != 0:
            print(f"Warning: codesign failed: {sign_res.stderr}", file=sys.stderr)
        else:
            signature_status = "adhoc"
            signed_app_sha256 = compute_app_bundle_sha256(app_dir)
            signed_exec_sha256 = compute_sha256(dest_bin)
            print("Codesign verification:")
            verify_res = subprocess.run(["codesign", "-vvv", "--deep", "--strict", str(app_dir)], capture_output=True, text=True)
            print(verify_res.stderr.strip() or "Verified clean ad-hoc signature.")

    summary = {
        "applicationVersion": version,
        "bundleIdentifier": bundle_id,
        "appBundlePath": str(app_dir),
        "signatureStatus": signature_status,
        "digests": {
            "unsignedAssetSHA256": unsigned_zip_sha256 or unsigned_exec_sha256,
            "appBundleSHA256": signed_app_sha256,
            "executableSHA256": signed_exec_sha256,
            "manifestSHA256": manifest_digest
        }
    }

    summary_path = output_dir / "package-summary.json"
    with open(summary_path, "w", encoding="utf-8") as f:
        json.dump(summary, f, indent=2)

    print(f"Package Summary saved to {summary_path}")
    return 0

def main():
    parser = argparse.ArgumentParser(description="Package Hotspot Byte Fence into canonical macOS .app")
    parser.add_argument("--binary", help="Path to compiled HotspotByteFence executable (defaults to .build/release or .build/debug)")
    parser.add_argument("--output", default="dist", help="Output directory (default: dist)")
    parser.add_argument("--no-sign", action="store_true", help="Skip ad-hoc signing")
    parser.add_argument("--no-zip", action="store_true", help="Skip creating unsigned ZIP archive")
    args = parser.parse_args()

    binary = None
    if args.binary:
        binary = Path(args.binary).resolve()
    else:
        candidates = [
            Path(".build/release/HotspotByteFence").resolve(),
            Path(".build/arm64-apple-macosx/release/HotspotByteFence").resolve(),
            Path(".build/debug/HotspotByteFence").resolve(),
            Path(".build/arm64-apple-macosx/debug/HotspotByteFence").resolve(),
        ]
        for c in candidates:
            if c.is_file() and os.access(c, os.X_OK):
                binary = c
                break

    if not binary or not binary.exists():
        print("Error: Could not find compiled HotspotByteFence executable. Run 'swift build' first.", file=sys.stderr)
        sys.exit(1)

    print(f"Using binary: {binary}")
    sys.exit(package_app(binary, Path(args.output).resolve(), sign=not args.no_sign, zip_bundle=not args.no_zip))

if __name__ == "__main__":
    main()
